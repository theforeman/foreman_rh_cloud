<%#
kind: job_template
name: Run remediations based on Insights recommendations
job_category: Red Hat Insights
description_format: 'Insights remediations for selected issues'
feature: rh_cloud_remediate_hosts
template_inputs:
- name: hit_remediation_pairs
  description: Pairs of issues and selected remediation
  input_type: user
  required: true
- name: host_insights_ids
  description: Comma-separated list of Insights system IDs (insights facet IDs). Only required for non-cloud remediations.
  input_type: user
  required: false
provider_type: Ansible
%>
<%= remediations_playbook(input('hit_remediation_pairs'), input('host_insights_ids')) %>